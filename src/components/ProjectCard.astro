---
import { displayImage } from '../data/portfolio.js';
type Project = {
  number: string;
  title: string;
  category: string;
  summary: string;
  impact: string;
  contribution: string;
  stack: string[];
  url: string;
  internal?: boolean;
  screenshots: { src: string; caption: string }[];
};
const { project } = Astro.props as { project: Project };
const first = project.screenshots[0];
const displayShots = project.screenshots.map((shot) => ({ ...shot, src: displayImage(shot.src) }));
---

<article class="project-card">
  <div class="project-copy">
    <div class="project-overline"><span>{project.number} / SELECTED WORK</span><span>{project.category}</span></div>
    <h4>{project.title}</h4>
    <p class="project-summary">{project.summary}</p>
    <div class="project-detail">
      <span class="detail-label">DAMPAK</span>
      <p>{project.impact}</p>
    </div>
    <div class="project-detail">
      <span class="detail-label">KONTRIBUSI</span>
      <p>{project.contribution}</p>
    </div>
    <ul class="tags" aria-label="Teknologi yang digunakan">
      {project.stack.map((tag) => <li>{tag}</li>)}
    </ul>
    {project.internal ? (
      <span class="text-link text-link--internal" aria-label={`${project.title} adalah aplikasi internal`}>
        <svg class="internal-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Aplikasi internal perusahaan
      </span>
    ) : (
      <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Buka ${project.title} di tab baru`}>Lihat situs</a>
    )}
  </div>
  <div class="project-visual" data-gallery>
    <div class="browser-frame">
      <div class="browser-top"><div class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>{project.title}</span></div>
      <img class="gallery-image" src={displayShots[0].src} alt={`${project.title}: ${first.caption}`} loading="lazy" decoding="async" />
    </div>
    <div class="gallery-controls">
      <span class="gallery-caption" aria-live="polite">{first.caption}</span>
      <div class="gallery-actions">
        <span class="gallery-count" aria-live="polite">01 / {String(project.screenshots.length).padStart(2, '0')}</span>
        <button type="button" class="gallery-prev" aria-label={`Screenshot sebelumnya untuk ${project.title}`} disabled>Sebelumnya</button>
        <button type="button" class="gallery-next" aria-label={`Screenshot berikutnya untuk ${project.title}`}>Berikutnya</button>
      </div>
    </div>
    <script type="application/json" class="gallery-data" set:html={JSON.stringify(displayShots)} />
  </div>
</article>
