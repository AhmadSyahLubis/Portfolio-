---
import { displayImage } from '../data/portfolio.js';
type Project = {
  number: string;
  title: string;
  category: string;
  summary: string;
  impact: string;
  contribution: string;
  stack: string[];
  url: string;
  screenshots: { src: string; caption: string }[];
};
type Labels = {
  selected: string;
  impact: string;
  contribution: string;
  technologies: string;
  site: string;
  openStart: string;
  openEnd: string;
  previous: string;
  next: string;
  previousAria: string;
  nextAria: string;
};
const { project, labels } = Astro.props as { project: Project; labels: Labels };
const first = project.screenshots[0];
const displayShots = project.screenshots.map((shot) => ({ ...shot, src: displayImage(shot.src) }));
---

<article class="project-card">
  <div class="project-copy">
    <div class="project-overline"><span>{project.number} / {labels.selected}</span><span>{project.category}</span></div>
    <h4>{project.title}</h4>
    <p class="project-summary">{project.summary}</p>
    <div class="project-detail">
      <span class="detail-label">{labels.impact}</span>
      <p>{project.impact}</p>
    </div>
    <div class="project-detail">
      <span class="detail-label">{labels.contribution}</span>
      <p>{project.contribution}</p>
    </div>
    <ul class="tags" aria-label={labels.technologies}>
      {project.stack.map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${labels.openStart} ${project.title} ${labels.openEnd}`}>{labels.site}</a>
  </div>
  <div class="project-visual" data-gallery>
    <div class="browser-frame">
      <div class="browser-top"><div class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>{project.title}</span></div>
      <img class="gallery-image" src={displayShots[0].src} alt={`${project.title}: ${first.caption}`} loading="lazy" decoding="async" />
    </div>
    <div class="gallery-controls">
      <span class="gallery-caption" aria-live="polite">{first.caption}</span>
      <div class="gallery-actions">
        <span class="gallery-count" aria-live="polite">01 / {String(project.screenshots.length).padStart(2, '0')}</span>
        <button type="button" class="gallery-prev" aria-label={`${labels.previousAria} ${project.title}`} disabled>{labels.previous}</button>
        <button type="button" class="gallery-next" aria-label={`${labels.nextAria} ${project.title}`}>{labels.next}</button>
      </div>
    </div>
    <script type="application/json" class="gallery-data" set:html={JSON.stringify(displayShots)} />
  </div>
</article>
